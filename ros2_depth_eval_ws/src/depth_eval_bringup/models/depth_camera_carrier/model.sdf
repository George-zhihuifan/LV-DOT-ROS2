<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="depth_camera_carrier">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 1.2 0 0 0</pose>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <visual name="mast_visual">
        <pose>-0.12 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.06 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.35 1</ambient>
          <diffuse>0.35 0.35 0.35 1</diffuse>
        </material>
      </visual>

      <sensor name="rgbd_camera" type="rgbd_camera">
        <pose>0.18 0 0.06 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>12.0</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>rgbd_camera</topic>
        <enable_metrics>true</enable_metrics>
      </sensor>
    </link>
  </model>
</sdf>
