<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="uav_d435i_platform">
    <static>true</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <gravity>false</gravity>
      <velocity_decay>
        <linear>0.2</linear>
        <angular>0.2</angular>
      </velocity_decay>
      <inertial>
        <mass>1.4</mass>
        <inertia>
          <ixx>0.03</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.03</iyy>
          <iyz>0.0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.36 0.26 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.16 0.16 0.18 1</ambient>
          <diffuse>0.20 0.20 0.24 1</diffuse>
        </material>
      </visual>

      <visual name="front_camera_housing">
        <pose>0.19 0.0 -0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.06 0.06 0.07 1</ambient>
          <diffuse>0.10 0.10 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="arm_x">
        <geometry>
          <box>
            <size>0.52 0.03 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.42 0.14 0.14 1</ambient>
          <diffuse>0.56 0.18 0.18 1</diffuse>
        </material>
      </visual>

      <visual name="arm_y">
        <geometry>
          <box>
            <size>0.03 0.52 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.14 0.14 0.42 1</ambient>
          <diffuse>0.18 0.18 0.56 1</diffuse>
        </material>
      </visual>

      <visual name="rotor_fl">
        <pose>0.23 0.23 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="rotor_fr">
        <pose>0.23 -0.23 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="rotor_rl">
        <pose>-0.23 0.23 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="rotor_rr">
        <pose>-0.23 -0.23 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <sensor name="d435i_color" type="camera">
        <pose>0.30 0.0 0.05 0 0 0</pose>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>rgbd_camera_color</topic>
        <enable_metrics>false</enable_metrics>
      </sensor>

      <sensor name="d435i_depth" type="depth_camera">
        <pose>0.30 0.0 0.05 0 0 0</pose>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <output>depths</output>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.010</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>rgbd_camera_depth</topic>
        <enable_metrics>false</enable_metrics>
      </sensor>

      <sensor name="d435i_imu" type="imu">
        <pose>0.02 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <topic>camera/imu</topic>
        <enable_metrics>true</enable_metrics>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.02</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.02</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.02</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="uav_lidar" type="gpu_lidar">
        <pose>0.18 0 0.06 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>uav_lidar/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
            <vertical>
              <samples>60</samples>
              <resolution>1</resolution>
              <min_angle>-0.122173</min_angle>
              <max_angle>0.907571</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>70.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>
  </model>
</sdf>
