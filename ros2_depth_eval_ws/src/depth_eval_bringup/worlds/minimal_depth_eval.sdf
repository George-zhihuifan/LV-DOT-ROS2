<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="minimal_depth_eval">
    <gravity>0 0 -9.8</gravity>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://depth_camera_carrier</uri>
      <pose>0 0.35 0 0 0 0</pose>
    </include>

    <include>
      <name>near_target</name>
      <uri>https://fuel.ignitionrobotics.org/1.0/Mingfei/models/actor_stand</uri>
      <pose>2.5 0.0 0.02 0 0 3.14159</pose>
    </include>

    <include>
      <name>mid_target</name>
      <uri>https://fuel.ignitionrobotics.org/1.0/Mingfei/models/actor_stand</uri>
      <pose>5.0 -1.2 0.02 0 0 3.14159</pose>
    </include>

    <include>
      <name>far_target</name>
      <uri>https://fuel.ignitionrobotics.org/1.0/Mingfei/models/actor_stand</uri>
      <pose>7.5 0.9 0.02 0 0 3.14159</pose>
    </include>
  </world>
</sdf>
